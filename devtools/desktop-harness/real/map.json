       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o65",
       "unit": "history:u02",
       "lesson": "history:u02:l04",
       "verb": "explain",
       "statement": "The CPRR's practice of omitting Chinese workers' names makes it difficult to recognize their individual contributions to railroad construction.",
       "kind": "reading",
       "prereqs": [
        "history:o64"
       ],
       "passage_ids": [
        "history-md:a-collective-contribution:2"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o66",
       "unit": "history:u02",
       "lesson": "history:u02:l04",
       "verb": "explain",
       "statement": "Chinese railroad workers' savings became the foundations for personal and community-wide growth in settlements such as Terrace, West Lake, and East Lake.",
       "kind": "reading",
       "prereqs": [
        "history:o65"
       ],
       "passage_ids": [
        "history-md:a-collective-contribution:1"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o67",
       "unit": "history:u02",
       "lesson": "history:u02:l04",
       "verb": "order",
       "statement": "Lee Wong Sang passed through CPRR work camps in the sequence of California, Nevada, and Utah between 1866 and 1869.",
       "kind": "reading",
       "prereqs": [
        "history:o66"
       ],
       "passage_ids": [
        "history-md:a-collective-contribution:2"
       ],
       "coverage": "covered",
