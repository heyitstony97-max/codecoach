  {
   "id": "history:u02",
   "title": "The Archeology of Chinese Laborers Who Connected the Country",
   "lessons": [
    {
     "id": "history:u02:l01",
     "title": "The Archeology of Chinese Laborers Who Connected the Country",
     "objectives": [
      {
       "id": "history:o44",
       "unit": "history:u02",
       "lesson": "history:u02:l01",
       "verb": "identify",
       "statement": "The learner can identify that over 12,000 Chinese immigrant laborers contributed to the construction of the first transcontinental railroad.",
       "kind": "reading",
       "prereqs": [
        "history:o43"
       ],
       "passage_ids": [
        "history-md:the-archeology-of-chinese-laborers-who-connected-the-country:1"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o45",
       "unit": "history:u02",
       "lesson": "history:u02:l01",
       "verb": "identify",
       "statement": "The learner can identify that Golden Spike National Historical Park is located in the arid region between the Sierra Nevada and Rocky Mountains.",
       "kind": "reading",
       "prereqs": [
        "history:o44"
       ],
       "passage_ids": [
        "history-md:the-archeology-of-chinese-laborers-who-connected-the-country:1"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o46",
       "unit": "history:u02",
       "lesson": "history:u02:l01",
       "verb": "explain",
       "statement": "The learner can explain that primary sources from Chinese railroad workers are scarce because no personal writings, letters, or diaries authored by them have been found.",
       "kind": "reading",
       "prereqs": [
        "history:o45"
       ],
       "passage_ids": [
        "history-md:the-archeology-of-chinese-laborers-who-connected-the-country:2"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o47",
       "unit": "history:u02",
       "lesson": "history:u02:l01",
       "verb": "identify",
       "statement": "The learner can identify that the available eyewitness accounts and visual images of Chinese railroad workers come from European American and European observers and often reflect anti-Chinese sentiment.",
       "kind": "reading",
       "prereqs": [
        "history:o46"
       ],
       "passage_ids": [
        "history-md:the-archeology-of-chinese-laborers-who-connected-the-country:2"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o48",
       "unit": "history:u02",
       "lesson": "history:u02:l01",
       "verb": "explain",
       "statement": "The learner can explain that the legacy of Chinese railroad workers is preserved through archaeological analyses of artifacts and features they left behind, and through stories passed down through generations of their descendants.",
       "kind": "reading",
       "prereqs": [
        "history:o47"
       ],
       "passage_ids": [
        "history-md:the-archeology-of-chinese-laborers-who-connected-the-country:2"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      }
     ]
    },
    {
     "id": "history:u02:l02",
     "title": "A Dream Slowly Becomes a Reality",
     "objectives": [
      {
       "id": "history:o49",
       "unit": "history:u02",
       "lesson": "history:u02:l02",
       "verb": "identify",
       "statement": "The Railway Act of 1862 authorized the Central Pacific Railroad (CPRR) to build the western portion and the Union Pacific Railroad (UPRR) to build the eastern portion of the chosen transcontinental railroad route.",
       "kind": "reading",
       "prereqs": [
        "history:o48"
       ],
       "passage_ids": [
        "history-md:a-dream-slowly-becomes-a-reality:1"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 0,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o50",
       "unit": "history:u02",
       "lesson": "history:u02:l02",
       "verb": "explain",
       "statement": "Labor shortages fueled by strikes and an unwillingness to increase wages led Superintendent J.H. Strobridge, at the urging of Charles Crocker, to hire Chinese immigrants for the CPRR, beginning with 50 men and eventually employing approximately 11,000 Chinese workers by 1868.",
       "kind": "reading",
       "prereqs": [
        "history:o49"
       ],
       "passage_ids": [
        "history-md:a-dream-slowly-becomes-a-reality:2"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o51",
       "unit": "history:u02",
       "lesson": "history:u02:l02",
       "verb": "identify",
       "statement": "Chinese laborers on the CPRR were paid an average of 30% less than their European or European-American counterparts, and the CPRR organized them into groups of up to 30 men, each with a leader responsible for receiving and distributing wages rather than recording individual names.",
       "kind": "reading",
       "prereqs": [
        "history:o50"
       ],
       "passage_ids": [
        "history-md:a-dream-slowly-becomes-a-reality:3"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o52",
       "unit": "history:u02",
       "lesson": "history:u02:l02",
       "verb": "identify",
       "statement": "CPRR crews faced dangerous conditions including sub-freezing and sweltering temperatures, blizzards and avalanches, bad water, and blasting accidents, which resulted in an unknown number of deaths estimated at hundreds or even thousands.",
       "kind": "reading",
       "prereqs": [
        "history:o51"
       ],
       "passage_ids": [
        "history-md:a-dream-slowly-becomes-a-reality:4"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o53",
       "unit": "history:u02",
       "lesson": "history:u02:l02",
       "verb": "order",
       "statement": "Sequence the following events: CPRR crews entered Utah Territory in March 1869; construction camps covered Promontory Summit in April and May 1869; on April 28, 1869, crews laid 10 miles and 56 feet of track in 12 hours; and before noon on May 10, 1869, eight Chinese men moved the final rail and ceremonial golden and silver spikes were driven.",
       "kind": "reading",
       "prereqs": [
        "history:o52"
       ],
       "passage_ids": [
        "history-md:a-dream-slowly-becomes-a-reality:5"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o54",
       "unit": "history:u02",
       "lesson": "history:u02:l02",
       "verb": "identify",
       "statement": "On April 28, 1869, Chinese construction crews and a smaller group of non-Chinese workers laid 10 miles and 56 feet of track in 12 hours, setting a construction record that has not been surpassed.",
       "kind": "reading",
       "prereqs": [
        "history:o53"
       ],
       "passage_ids": [
        "history-md:a-dream-slowly-becomes-a-reality:5"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      }
     ]
    },
    {
     "id": "history:u02:l03",
     "title": "Addressing an Archeological Paradox",
     "objectives": [
      {
       "id": "history:o55",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "identify",
       "statement": "The archeological paradox is that artifacts and structures are anchored in specific places, while the Chinese laborers who deposited them are represented through materials strewn across thousands of miles.",
       "kind": "reading",
       "prereqs": [
        "history:o54"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:1"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o56",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "identify",
       "statement": "About 31 worker campsites and supply camps were found on the slopes of Promontory Summit, and hundreds more were located throughout the North American West, and these remains are the only evidence of the human activity in the final months of railroad construction and completion.",
       "kind": "reading",
       "prereqs": [
        "history:o55"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:2"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o57",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "define",
       "statement": "A dugout is a shallow depression that survives today as a trace of the shelter housing Chinese railroad workers built to protect them from the elements.",
       "kind": "reading",
       "prereqs": [
        "history:o56"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:3"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o58",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "identify",
       "statement": "The range of Chinese dwellings excavated along the railroad—tents, dugouts, and formal houses—demonstrates both the initial construction phase and the much longer period when crews were maintaining the railroads.",
       "kind": "reading",
       "prereqs": [
        "history:o57"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:3"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o59",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "compare",
       "statement": "The 1880 Census reported 54 Chinese individuals in Terrace but ignored Chinese inhabitants in West Lake and East Lake, whereas field investigations revealed a substantial Chinese community in those latter locations during the 1870s and 1880s.",
       "kind": "reading",
       "prereqs": [
        "history:o58"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:4"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o60",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "compare",
       "statement": "Imported Chinese porcelain bowls from camps prior to 1870 are decorated in a 'double happiness' and 'bamboo' motif, while those from camps after 1870 include 'wintergreen' and 'four seasons' patterns.",
       "kind": "reading",
       "prereqs": [
        "history:o59"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:5"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o61",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "identify",
       "statement": "Clothing fasteners found at Chinese railroad camps, such as metal suspender clasps and shell shirt buttons, represent Chinese workers adopting Western-style garments.",
       "kind": "reading",
       "prereqs": [
        "history:o60"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:5"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o62",
       "unit": "history:u02",
       "lesson": "history:u02:l03",
       "verb": "explain",
       "statement": "Artifacts from even the most remote Chinese railroad worker camps show a uniformity of supplies, provisions, and domestic items, offering personal glimpses into workers' lives that are otherwise forgotten or omitted in mainstream history.",
       "kind": "reading",
       "prereqs": [
        "history:o61"
       ],
       "passage_ids": [
        "history-md:addressing-an-archeological-paradox:5"
       ],
       "coverage": "covered",
       "mastery": 0.2,
       "items_active": 1,
       "due_reviews": 0,
       "status_label": null
      }
     ]
    },
    {
