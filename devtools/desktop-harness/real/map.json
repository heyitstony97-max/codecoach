     "title": "A Collective Contribution",
     "objectives": [
      {
       "id": "history:o63",
       "unit": "history:u02",
       "lesson": "history:u02:l04",
       "verb": "identify",
       "statement": "The 1882 Chinese Exclusion Act caused railroad jobs to shift to other immigrant communities, and most Chinese workers were replaced on U.S. railroads by 1910.",
       "kind": "reading",
       "prereqs": [
        "history:o62"
       ],
       "passage_ids": [
        "history-md:a-collective-contribution:1"
       ],
       "coverage": "covered",
