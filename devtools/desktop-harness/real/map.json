       "items_active": 0,
       "due_reviews": 0,
       "status_label": null
      },
      {
       "id": "history:o64",
       "unit": "history:u02",
       "lesson": "history:u02:l04",
       "verb": "identify",
       "statement": "A few identified Chinese railroad workers listed in the Southern Pacific Bulletin are Ah Hop, Toy Gee, and Charlie Dan.",
       "kind": "reading",
       "prereqs": [
        "history:o63"
       ],
       "passage_ids": [
        "history-md:a-collective-contribution:2"
       ],
       "coverage": "covered",
